@@ -144,3 +144,19 @@
 /* USER CODE BEGIN 4 */
+/* printf() -> _write() in syscalls.c -> __io_putchar() -> USART2. */
+int __io_putchar(int ch)
+{
+  uint8_t byte;
+  if (ch == '\n') {
+    byte = '\r';
+    if (HAL_UART_Transmit(&huart2, &byte, 1, 1000) != HAL_OK) {
+      return EOF;
+    }
+  }
+  byte = (uint8_t)ch;
+  if (HAL_UART_Transmit(&huart2, &byte, 1, 1000) != HAL_OK) {
+    return EOF;
+  }
+  return ch;
+}
 
 /* USER CODE END 4 */
